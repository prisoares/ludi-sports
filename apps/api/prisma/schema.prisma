generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  USER
  PARTNER
}

enum BookingStatus {
  requested
  hold_15m
  accepted
  payment_pending
  confirmed
  expired
  cancelled
  no_show
}

enum PaymentStatus {
  stub
  pending
  paid
  refunded
  failed
}

enum PaymentMethod {
  PIX
}

enum MapFeeStatus {
  pending
  paid
  overdue
  stub
}

enum MonthlyInvoiceStatus {
  draft
  pending
  paid
  cancelled
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  cpf          String   @unique
  passwordHash String
  roles        AccountRole[] @default([USER])
  activeRole   AccountRole   @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedVenues  Venue[]  @relation("VenueOwner")
  bookings     Booking[] @relation("UserBookings")
  partnerBookings Booking[] @relation("PartnerBookings")
  pushTokens DevicePushToken[]
  chatMessages ChatMessage[]
}

model Sport {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  iconKey   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  courts Court[]
}

model Venue {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  address      String
  neighborhood String
  city         String   @default("Porto Alegre")
  state        String   @default("RS")
  country      String   @default("BR")
  lat          Float
  lng          Float
  photoUrls    String[]
  active       Boolean  @default(true)
  /// Visible on public map; set false when map-fee unpaid past due.
  mapVisible   Boolean  @default(true)
  ownerId      String?
  owner        User?    @relation("VenueOwner", fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courts            Court[]
  bookings          Booking[]
  monthlyInvoices   VenueMonthlyInvoice[]
  mapFeeInvoices    MapFeeInvoice[]

  @@index([city, state])
  @@index([lat, lng])
  @@index([mapVisible, active])
}

model Court {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id])
  name        String
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings       Booking[]
  availabilities CourtAvailability[]
  blocks         CourtBlock[]

  @@index([venueId])
  @@index([sportId])
}

model CourtAvailability {
  id          String   @id @default(cuid())
  courtId     String
  court       Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  /// 0=Domingo .. 6=Sábado
  weekday     Int
  startMinute Int
  endMinute   Int
  priceCents  Int?
  createdAt   DateTime @default(now())

  @@index([courtId, weekday])
}

model CourtBlock {
  id        String   @id @default(cuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([courtId, startsAt])
}

/// Monthly 1% GMV map listing fee (prior-month paid bookings) — Phase 1b cron/enforce.
model MapFeeInvoice {
  id            String       @id @default(cuid())
  venueId       String
  venue         Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  year          Int
  month         Int
  gmvCents      Int
  feeCents      Int
  status        MapFeeStatus @default(pending)
  dueAt         DateTime
  paidAt        DateTime?
  asaasChargeId String?
  pixCopyPaste  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([venueId, year, month])
  @@index([status, dueAt])
}

/// Taxa mensal 1% do GMV — partner-web / BillingService on main.
model VenueMonthlyInvoice {
  id              String               @id @default(cuid())
  venueId         String
  venue           Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  yearMonth       String
  gmvCents        Int
  feeCents        Int
  status          MonthlyInvoiceStatus @default(draft)
  asaasChargeId   String?
  pixCopyPaste    String?
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([venueId, yearMonth])
  @@index([status])
}

model Booking {
  id              String        @id @default(cuid())
  status          BookingStatus @default(requested)
  userId          String
  user            User          @relation("UserBookings", fields: [userId], references: [id])
  partnerId       String?
  partner         User?         @relation("PartnerBookings", fields: [partnerId], references: [id])
  venueId         String
  venue           Venue         @relation(fields: [venueId], references: [id])
  courtId         String
  court           Court         @relation(fields: [courtId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  holdExpiresAt   DateTime?
  paymentDueAt    DateTime?
  priceCents      Int
  commissionCents Int           @default(0)
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment Payment?
  chatMessages ChatMessage[]

  @@index([status])
  @@index([venueId, startsAt])
  @@index([courtId, startsAt, endsAt])
  @@index([userId])
  @@index([partnerId, status])
}

/// Asaas Pix — stub when ASAAS_API_KEY empty; webhook marks paid.
model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status          PaymentStatus @default(stub)
  method          PaymentMethod @default(PIX)
  amountCents     Int
  refundCents     Int           @default(0)
  asaasChargeId   String?
  pixCopyPaste    String?
  pixQrCodeBase64 String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([asaasChargeId])
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}
